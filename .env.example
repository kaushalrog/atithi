# Copy this file to .env and fill in real values. NEVER commit .env.
GEMINI_API_KEY=your_gemini_api_key_here
# Give up on a Gemini request after this many seconds (default 30).
GEMINI_TIMEOUT_S=30
# Optional: override the chat model (newer API keys cannot use gemini-2.5-flash)
GEMINI_MODEL=
GOOGLE_SHEETS_CREDENTIALS_PATH=credentials.json
SHEET_ID=your_google_sheet_id_here
# Protects the /admin console (platform owner only). At least 12 characters;
# this placeholder (and anything shorter) keeps the admin console DISABLED.
ADMIN_PASSWORD=choose_a_strong_password

# Phone system (Twilio). Live calls stay OFF until you set ENABLE_LIVE_CALLS=true,
# and you should only do that after the checklist in docs/SAFE_TESTING.md passes.
ENABLE_LIVE_CALLS=false
# Text customers booking confirmations and reminders (Twilio SMS). Off = dry run:
# every message is written to notifications.jsonl instead of being sent.
ENABLE_SMS=false
# Live handoff: a caller who asks for a person is connected to the business's
# own phone (Settings > Phone line). Off = the agent takes an urgent callback.
ENABLE_HANDOFF=false
# Ring customers back (missed-call mode, busy lines), in opening hours only,
# one call per number per 6 h, at most 30 a day per business.
ENABLE_CALLBACKS=false
# WhatsApp receptionist: replies to customers' WhatsApp messages (Twilio
# WhatsApp; a business is reached via whatsapp_number in its YAML).
ENABLE_WHATSAPP=false
# Simultaneous phone calls allowed (Gemini Live free tier: about 3).
MAX_CONCURRENT_CALLS=3
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_NUMBER=+1xxxxxxxxxx
# Where Twilio can reach this server from the internet (ngrok or your host):
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app
# Business that answers calls to numbers not mapped in any client YAML:
DEFAULT_CLIENT=demo_clinic
# Optional: only if your network blocks Cloudflare tunnels (free at ngrok.com):
NGROK_AUTHTOKEN=

# Accounts & billing
ADMIN_EMAIL=you@example.com
BILLING_PRICE_INR=1999
# Your UPI id — shown to owners with a copy button when payment is due:
BILLING_UPI=

# Optional: send password-reset codes by email (Gmail: use an App Password).
# Leave empty and reset codes appear in your admin console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
